# Force LF line endings in the repository for all text files.
# Developers on Windows get CRLF in their working copy if their git
# core.autocrlf is set, but the repo always stores LF.
* text=auto eol=lf

# Binary files — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
