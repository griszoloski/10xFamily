---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listEvents, detectCarConflicts } from "@/lib/services/events";
import DeleteEventButton from "@/components/events/DeleteEventButton";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const events = supabase ? await listEvents(supabase).catch(() => []) : [];
const conflictPairs = detectCarConflicts(events);
const conflictingIds = new Set(conflictPairs.flatMap((p) => [p.a.id, p.b.id]));

const successMsg = Astro.url.searchParams.get("success") === "1";
const updatedMsg = Astro.url.searchParams.get("updated") === "1";
const deletedMsg = Astro.url.searchParams.get("deleted") === "1";
const carConflictMsg = Astro.url.searchParams.get("car_conflict") === "1";
---

<Layout title="Moje wydarzenia">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Moje wydarzenia
        </h1>
        <a
          href="/events/new"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Dodaj wydarzenie
        </a>
      </div>

      {
        successMsg && (
          <div class="mb-4 rounded-lg border border-green-400/30 bg-green-400/10 px-4 py-3 text-sm text-green-200">
            Wydarzenie zostało dodane!
          </div>
        )
      }
      {
        updatedMsg && (
          <div class="mb-4 rounded-lg border border-blue-400/30 bg-blue-400/10 px-4 py-3 text-sm text-blue-200">
            Wydarzenie zostało zaktualizowane.
          </div>
        )
      }
      {
        deletedMsg && (
          <div class="mb-4 rounded-lg border border-orange-400/30 bg-orange-400/10 px-4 py-3 text-sm text-orange-200">
            Wydarzenie zostało usunięte.
          </div>
        )
      }
      {
        carConflictMsg && (
          <div class="mb-4 rounded-lg border border-amber-400/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-200">
            Zapisano. Sprawdź alerty konfliktu auta poniżej.
          </div>
        )
      }

      {
        conflictPairs.map((pair) => {
          const fmtTime = (s: string) =>
            new Date(s).toLocaleTimeString("pl-PL", { hour: "2-digit", minute: "2-digit" });
          return (
            <div class="mb-3 rounded-lg border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-red-200">
              <span class="font-semibold">⚠ Konflikt auta:</span> <span class="font-medium">{pair.a.title}</span> (
              {fmtTime(pair.a.starts_at)}, {pair.a.duration_minutes} min, {pair.a.subject.display_name}) koliduje z{" "}
              <span class="font-medium">{pair.b.title}</span> ({fmtTime(pair.b.starts_at)}, {pair.b.duration_minutes}{" "}
              min, {pair.b.subject.display_name})
            </div>
          );
        })
      }

      {
        events.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/60 backdrop-blur-xl">
            Nie masz jeszcze żadnych wydarzeń. Dodaj pierwsze!
          </div>
        ) : (
          <ul class="space-y-3">
            {events.map((event) => {
              const isConflicting = conflictingIds.has(event.id);
              const date = new Date(event.starts_at);
              const formatted = date.toLocaleString("pl-PL", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
              });
              return (
                <li
                  class:list={`rounded-2xl border bg-white/10 p-4 text-white backdrop-blur-xl ${isConflicting ? "border-l-4 border-red-400/50 border-l-red-400" : "border-white/10"}`}
                >
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <h2 class="font-semibold">
                      {isConflicting && <span class="mr-1 text-red-300">⚠</span>}
                      {event.title}
                    </h2>
                    <span class="text-xs text-blue-100/60">{formatted}</span>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/80">
                    <span>Osoba: {event.subject.display_name}</span>
                    <span>Czas trwania: {event.duration_minutes} min</span>
                    {event.location && <span>Lokalizacja: {event.location}</span>}
                    {event.car_needed && <span>Auto: {event.driver ? event.driver.display_name : "potrzebne"}</span>}
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-2">
                    <a
                      href={`/events/${event.id}/edit`}
                      class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/20"
                    >
                      Edytuj
                    </a>
                    <DeleteEventButton eventId={event.id} client:load />
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }

      <div class="mt-6">
        <a href="/dashboard" class="text-sm text-blue-100/60 hover:text-blue-100/80"> ← Wróć do dashboardu </a>
      </div>
    </div>
  </div>
</Layout>
