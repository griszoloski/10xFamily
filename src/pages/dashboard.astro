---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listEventsByDateRange, detectCarConflicts } from "@/lib/services/events";
import type { EventWithProfiles } from "@/lib/services/events";

// Use Europe/Warsaw locale to derive the calendar date — toISOString() is UTC-anchored
// and would give yesterday's date between 00:00–02:00 CET for a UTC+2 household.
const toWarsawDate = (d: Date) =>
  d
    .toLocaleDateString("pl-PL", { timeZone: "Europe/Warsaw", year: "numeric", month: "2-digit", day: "2-digit" })
    .split(".")
    .reverse()
    .join("-");
const todayStr = toWarsawDate(new Date());
const windowEndStr = toWarsawDate(new Date(Date.now() + 7 * 24 * 60 * 60 * 1000));

const supabase = createClient(Astro.request.headers, Astro.cookies);
const windowEvents = supabase
  ? await listEventsByDateRange(supabase, `${todayStr}T00:00:00`, `${windowEndStr}T23:59:59`).catch(() => [])
  : [];

const todayEvents = windowEvents.filter((e) => e.starts_at.slice(0, 10) === todayStr);
const upcomingEvents = windowEvents.filter((e) => e.starts_at.slice(0, 10) > todayStr);

const upcomingByDay = new Map<string, EventWithProfiles[]>();
for (const event of upcomingEvents) {
  const day = event.starts_at.slice(0, 10);
  const bucket = upcomingByDay.get(day) ?? [];
  bucket.push(event);
  upcomingByDay.set(day, bucket);
}

const conflictPairs = detectCarConflicts(windowEvents);

const todayFormatted = new Date().toLocaleDateString("pl-PL", {
  weekday: "long",
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const fmtTime = (s: string) => new Date(s).toLocaleTimeString("pl-PL", { hour: "2-digit", minute: "2-digit" });

const fmtDayHeader = (isoDate: string) => {
  const [year, month, day] = isoDate.split("-").map(Number);
  return new Date(year, month - 1, day).toLocaleDateString("pl-PL", {
    weekday: "long",
    day: "2-digit",
    month: "long",
  });
};
---

<Layout title="Dashboard Dziś">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <!-- Header -->
      <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Dashboard Dziś
          </h1>
          <p class="mt-1 text-sm text-blue-100/60 capitalize">{todayFormatted}</p>
        </div>
        <a
          href="/events/new"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          + Dodaj wydarzenie
        </a>
      </div>

      <!-- Conflict banners -->
      {
        conflictPairs.map((pair) => (
          <div class="mb-3 rounded-lg border border-red-400/40 bg-red-400/10 px-4 py-3 text-sm text-red-200">
            <span class="font-semibold">⚠ Konflikt auta:</span> <span class="font-medium">{pair.a.title}</span> (
            {fmtTime(pair.a.starts_at)}, {pair.a.duration_minutes} min, {pair.a.subject.display_name}) koliduje z{" "}
            <span class="font-medium">{pair.b.title}</span> ({fmtTime(pair.b.starts_at)}, {pair.b.duration_minutes} min,{" "}
            {pair.b.subject.display_name})
          </div>
        ))
      }

      <!-- Sekcja Dziś -->
      <section class="mb-8">
        <h2 class="mb-3 text-lg font-semibold text-blue-100/80">Dziś</h2>
        {
          todayEvents.length === 0 ? (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-sm text-blue-100/60 backdrop-blur-xl">
              Brak wydarzeń na dziś.
            </div>
          ) : (
            <ul class="space-y-3">
              {todayEvents.map((event) => (
                <li class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <h3 class="font-semibold">{event.title}</h3>
                    <span class="text-xs text-blue-100/60">{fmtTime(event.starts_at)}</span>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/80">
                    <span>Osoba: {event.subject.display_name}</span>
                    <span>{event.duration_minutes} min</span>
                    {event.car_needed && <span>Auto: {event.driver ? event.driver.display_name : "potrzebne"}</span>}
                    {event.location && <span>Lokalizacja: {event.location}</span>}
                  </div>
                  <div class="mt-2">
                    <a href={`/events/${event.id}/edit`} class="text-xs text-blue-100/50 hover:text-blue-100/80">
                      Edytuj
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <!-- Sekcja Najbliższe 7 dni -->
      <section class="mb-8">
        <h2 class="mb-3 text-lg font-semibold text-blue-100/80">Najbliższe 7 dni</h2>
        {
          upcomingByDay.size === 0 ? (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-sm text-blue-100/60 backdrop-blur-xl">
              Brak nadchodzących wydarzeń.
            </div>
          ) : (
            <div class="space-y-5">
              {[...upcomingByDay.entries()].map(([day, dayEvents]) => (
                <div>
                  <h3 class="mb-2 text-sm font-medium text-blue-100/60 capitalize">{fmtDayHeader(day)}</h3>
                  <ul class="space-y-2">
                    {dayEvents.map((event) => (
                      <li class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                          <h4 class="font-semibold">{event.title}</h4>
                          <span class="text-xs text-blue-100/60">{fmtTime(event.starts_at)}</span>
                        </div>
                        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-blue-100/80">
                          <span>Osoba: {event.subject.display_name}</span>
                          <span>{event.duration_minutes} min</span>
                          {event.car_needed && (
                            <span>Auto: {event.driver ? event.driver.display_name : "potrzebne"}</span>
                          )}
                          {event.location && <span>Lokalizacja: {event.location}</span>}
                        </div>
                        <div class="mt-2">
                          <a href={`/events/${event.id}/edit`} class="text-xs text-blue-100/50 hover:text-blue-100/80">
                            Edytuj
                          </a>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Nawigacja -->
      <div class="flex flex-wrap items-center gap-3 border-t border-white/10 pt-6">
        <a
          href="/events"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Wszystkie wydarzenia
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
